{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.douyin-knowledge/schemas/structured-content-v1.schema.json",
  "title": "Douyin Knowledge Structured Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "primary_category", "tags", "review_status",
    "one_sentence_summary", "content_summary", "core_points", "argument_structure",
    "cases_and_data", "proper_noun_review", "numeric_review", "timeline_interpretation",
    "reusable_knowledge", "action_items", "keywords", "related_knowledge",
    "visual_evidence", "pending_review"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 8, "maxLength": 100},
    "primary_category": {"type": "string", "minLength": 2, "maxLength": 40},
    "tags": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 30}},
    "review_status": {"enum": ["verified", "needs_review"]},
    "one_sentence_summary": {"type": "string", "minLength": 20, "maxLength": 220},
    "content_summary": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 30, "maxLength": 500}},
    "core_points": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "minLength": 20, "maxLength": 300}},
    "argument_structure": {
      "type": "array", "minItems": 3, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["step", "claim", "evidence"], "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 20},
        "claim": {"type": "string", "minLength": 20, "maxLength": 300},
        "evidence": {"type": "string", "minLength": 20, "maxLength": 500}
      }}
    },
    "cases_and_data": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["claim", "evidence"], "properties": {
        "claim": {"type": "string", "minLength": 15, "maxLength": 300},
        "evidence": {"type": "string", "minLength": 15, "maxLength": 500}
      }}
    },
    "proper_noun_review": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/properNounReview"}},
    "numeric_review": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"$ref": "#/$defs/numericReview"}},
    "timeline_interpretation": {
      "type": "array", "minItems": 3, "maxItems": 20,
      "items": {"type": "object", "additionalProperties": false, "required": ["timestamp", "explanation"], "properties": {
        "timestamp": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}(?::[0-9]{2})?$"},
        "explanation": {"type": "string", "minLength": 20, "maxLength": 500}
      }}
    },
    "reusable_knowledge": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 20, "maxLength": 400}},
    "action_items": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"type": "string", "minLength": 15, "maxLength": 300}},
    "keywords": {"type": "array", "minItems": 4, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 30}},
    "related_knowledge": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {"type": "object", "additionalProperties": false, "required": ["title", "reason"], "properties": {
        "title": {"type": "string", "minLength": 2, "maxLength": 120},
        "reason": {"type": "string", "minLength": 15, "maxLength": 300}
      }}
    },
    "visual_evidence": {
      "type": "array", "minItems": 3, "maxItems": 8,
      "items": {"type": "object", "additionalProperties": false, "required": ["frame_index", "claim"], "properties": {
        "frame_index": {"type": "integer", "minimum": 1, "maximum": 8},
        "claim": {"type": "string", "minLength": 15, "maxLength": 300}
      }}
    },
    "pending_review": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 5, "maxLength": 300}}
  },
  "$defs": {
    "verdict": {"enum": ["verified", "unresolved", "not_applicable"]},
    "properNounReview": {
      "type": "object", "additionalProperties": false, "required": ["term", "normalized", "evidence", "verdict"],
      "properties": {
        "term": {"type": "string", "minLength": 1, "maxLength": 100},
        "normalized": {"type": "string", "minLength": 1, "maxLength": 150},
        "evidence": {"type": "string", "minLength": 10, "maxLength": 500},
        "verdict": {"$ref": "#/$defs/verdict"}
      }
    },
    "numericReview": {
      "type": "object", "additionalProperties": false, "required": ["value", "normalized", "evidence", "verdict"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "maxLength": 100},
        "normalized": {"type": "string", "minLength": 1, "maxLength": 150},
        "evidence": {"type": "string", "minLength": 10, "maxLength": 500},
        "verdict": {"$ref": "#/$defs/verdict"}
      }
    }
  }
}
